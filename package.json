  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/bootstrap.js",
    "start": "node src/bootstrap.js",
    "check": "find src test -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test",
