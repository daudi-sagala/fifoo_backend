{
  "name": "fifoo-game-backend",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/bootstrap.js",
    "start": "node src/bootstrap.js",
    "check": "find src test scripts -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test",
    "migrate": "node src/migrate.js",
    "generate:daily": "node src/jobs/generateDailyPaths.js",
    "verify:phase3": "node scripts/verify-phase3-e2e.js",
    "export:learning": "node scripts/export-learning-data.js",
    "verify:phase4": "node scripts/verify-phase4-learning.js",
    "train:phase5": "node scripts/train-phase5-model.js",
    "promote:phase5": "node scripts/promote-phase5-model.js",
    "verify:phase5": "node scripts/verify-phase5-models.js",
    "run:model-ops": "node scripts/run-model-ops.js",
    "verify:phase6": "node scripts/verify-phase6-model-ops.js",
    "rollback:phase6": "node scripts/rollback-phase6-model.js",
    "verify:phase7": "node scripts/verify-phase7-support-planning.js",
    "verify:phase8": "node scripts/verify-phase8-onboarding.js",
    "seed:production-test": "node scripts/seed-production-test-data.js --confirm-temporary-production-seed",
    "cleanup:production-test": "node scripts/seed-production-test-data.js --cleanup --confirm-temporary-production-seed"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@azure/identity": "^4.13.2",
    "@azure/monitor-opentelemetry": "^1.19.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
