NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fifoo
PGSSL=false
CORS_ORIGIN=http://localhost:3000

# Authentication
# development: accepts real Fifoo sessions and, when enabled, the explicit dummy token.
# internal: Fifoo signup/login sessions are the authentication authority.
# external: POSTs socket credentials to AUTH_VERIFY_URL and expects {"userID":"<uuid>"}.
# Production startup refuses AUTH_MODE=development, dummy auth, exposed reset tokens, or wildcard CORS.
AUTH_MODE=development
ALLOW_DUMMY_AUTH=true
DUMMY_AUTH_TOKEN=DUMMY_AUTH_TOKEN
# Must be the UUID of an existing row in users.
DUMMY_USER_ID=00000000-0000-4000-8000-000000000001
AUTH_VERIFY_URL=
AUTH_VERIFY_TIMEOUT_MS=5000
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_EXPOSE_RESET_TOKEN=true
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_DELIVERY_URL=
PASSWORD_RESET_DELIVERY_SECRET=
PASSWORD_RESET_DEEP_LINK_BASE=fifoo://reset-password
SOCKET_AUTH_TIMEOUT_MS=10000

# Optional telemetry persistence for game:application:action.
PERSIST_APPLICATION_ACTIONS=false
LOG_APPLICATION_ACTIONS=true

# Operational limits
MAX_SEARCH_RESULTS=50
MAX_LIVE_HISTORY=100
MAX_MUTATION_PAYLOAD_BYTES=1048576

# Daily path generation fallback until user profiles own a persisted timezone.
DEFAULT_TIME_ZONE=America/New_York
