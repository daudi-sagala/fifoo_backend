# ============================================================
# Local development defaults only. Never copy development
# credentials into the production App Service configuration.
# ============================================================
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
TRUST_PROXY=false
REQUIRE_HTTPS=false

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fifoo
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=false
PGSSL_CA=
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=30000
PG_IDLE_TRANSACTION_TIMEOUT_MS=30000

CORS_ORIGIN=http://localhost:3000

# Authentication
# development accepts real Fifoo sessions plus optional explicit dummy auth.
AUTH_MODE=development
ALLOW_DUMMY_AUTH=true
DUMMY_AUTH_TOKEN=DUMMY_AUTH_TOKEN
DUMMY_USER_ID=00000000-0000-4000-8000-000000000001
AUTH_VERIFY_URL=
AUTH_VERIFY_TIMEOUT_MS=5000
OUTBOUND_HTTP_TIMEOUT_MS=10000
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_EXPOSE_RESET_TOKEN=true
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_URL_BASE=fifoo://reset-password
SOCKET_AUTH_TIMEOUT_MS=10000

# Password-reset delivery. Production defaults to Azure Communication Services.
EMAIL_PROVIDER=console
AZURE_COMMUNICATION_EMAIL_ENDPOINT=
AZURE_COMMUNICATION_EMAIL_CONNECTION_STRING=
EMAIL_SENDER_ADDRESS=
EMAIL_REPLY_TO_ADDRESS=
# Backward-compatible webhook provider if EMAIL_PROVIDER=webhook.
PASSWORD_RESET_DELIVERY_URL=
PASSWORD_RESET_DELIVERY_SECRET=

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=
LOG_LEVEL=debug

# Rate limiting (application-level second line of defense; Azure Front Door WAF can add edge limits)
RATE_LIMIT_ENABLED=true
GENERAL_RATE_LIMIT_PER_MINUTE=300
AUTH_LOGIN_RATE_LIMIT_PER_15_MINUTES=20
AUTH_SIGNUP_RATE_LIMIT_PER_HOUR=10
AUTH_PASSWORD_RESET_RATE_LIMIT_PER_HOUR=6
SOCKET_CONNECTION_RATE_LIMIT_PER_MINUTE=60
SOCKET_MUTATION_RATE_LIMIT_PER_MINUTE=240

# Startup / operations
RUN_MIGRATIONS_ON_START=false
DAILY_PATH_SCHEDULER_ENABLED=false
DAILY_PATH_SCHEDULER_INTERVAL_MS=300000
DAILY_PATH_SCHEDULER_STARTUP_DELAY_MS=15000
DEFAULT_TIME_ZONE=America/New_York

# Optional telemetry persistence for game:application:action.
PERSIST_APPLICATION_ACTIONS=false
LOG_APPLICATION_ACTIONS=true

# Operational limits
MAX_SEARCH_RESULTS=50
MAX_LIVE_HISTORY=100
MAX_MUTATION_PAYLOAD_BYTES=1048576
MAX_HTTP_PAYLOAD_BYTES=1048576
