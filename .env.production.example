# Non-secret production settings. Put DATABASE_URL and any ACS connection
# string in Azure Key Vault and expose them through Key Vault references.
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://api.fifoo.ai
TRUST_PROXY=true
REQUIRE_HTTPS=true
CORS_ORIGIN=https://fifoo.ai,https://www.fifoo.ai

AUTH_MODE=internal
ALLOW_DUMMY_AUTH=false
AUTH_EXPOSE_RESET_TOKEN=false
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_URL_BASE=https://fifoo.ai/reset-password
SOCKET_AUTH_TIMEOUT_MS=10000
OUTBOUND_HTTP_TIMEOUT_MS=10000

PGSSL=true
PGSSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=30000
PG_IDLE_TRANSACTION_TIMEOUT_MS=30000

EMAIL_PROVIDER=azure-communication-services
# Preferred: endpoint + App Service managed identity.
AZURE_COMMUNICATION_EMAIL_ENDPOINT=https://YOUR-ACS-RESOURCE.communication.azure.com
EMAIL_SENDER_ADDRESS=DoNotReply@YOUR-VERIFIED-DOMAIN
EMAIL_REPLY_TO_ADDRESS=support@fifoo.ai

# Set by App Service from the Application Insights resource.
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
LOG_LEVEL=info

RATE_LIMIT_ENABLED=true
GENERAL_RATE_LIMIT_PER_MINUTE=300
AUTH_LOGIN_RATE_LIMIT_PER_15_MINUTES=20
AUTH_SIGNUP_RATE_LIMIT_PER_HOUR=10
AUTH_PASSWORD_RESET_RATE_LIMIT_PER_HOUR=6
SOCKET_CONNECTION_RATE_LIMIT_PER_MINUTE=60
SOCKET_MUTATION_RATE_LIMIT_PER_MINUTE=240

RUN_MIGRATIONS_ON_START=true
DAILY_PATH_SCHEDULER_ENABLED=true
DAILY_PATH_SCHEDULER_INTERVAL_MS=300000
DAILY_PATH_SCHEDULER_STARTUP_DELAY_MS=15000
DEFAULT_TIME_ZONE=America/New_York

PERSIST_APPLICATION_ACTIONS=false
LOG_APPLICATION_ACTIONS=false
MAX_SEARCH_RESULTS=50
MAX_LIVE_HISTORY=100
MAX_MUTATION_PAYLOAD_BYTES=1048576
MAX_HTTP_PAYLOAD_BYTES=1048576

# Secrets resolved from Azure Key Vault references in App Service:
# DATABASE_URL=@Microsoft.KeyVault(VaultName=...;SecretName=fifoo-database-url)
# Optional ACS fallback instead of managed identity:
# AZURE_COMMUNICATION_EMAIL_CONNECTION_STRING=@Microsoft.KeyVault(...)
